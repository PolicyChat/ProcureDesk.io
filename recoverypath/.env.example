# ---- Claude explanation layer (optional) -----------------------------------
# Without a key, explanations fall back to the approved content verbatim.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# ---- Stripe (optional) -------------------------------------------------------
# Without a key, checkout runs in DEMO mode (instant unlock, no charge) unless
# DEMO_PAYMENTS=false.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3001
# DEMO_PAYMENTS=false

# ---- Supabase (optional) -----------------------------------------------------
# Used server-side only, for anonymous funnel analytics. See supabase/migrations.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Legal content gating ----------------------------------------------------
# Production should only serve rules whose status is "published".
# While no module is attorney-approved, set this to true to run the engine on
# draft content (the UI shows a "not attorney reviewed" banner).
NEXT_PUBLIC_RULES_INCLUDE_UNREVIEWED=true

# ---- Admin -------------------------------------------------------------------
# Basic-auth password for /admin. If unset, /admin is open in dev and blocked in production.
ADMIN_PASSWORD=
